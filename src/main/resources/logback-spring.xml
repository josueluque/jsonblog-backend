<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Patron que incluye el requestId del MDC para trazabilidad -->
    <property name="LOG_PATTERN_DEV"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %highlight(%-5level) [%X{requestId:-no-request-id}] %cyan(%logger{36}) - %msg%n"/>
    <property name="LOG_PATTERN_PROD"
              value="%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [requestId=%X{requestId:-}] %logger{40} - %msg%n"/>

    <springProfile name="prod">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>${LOG_PATTERN_PROD}</pattern>
            </encoder>
        </appender>
    </springProfile>

    <springProfile name="!prod">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>${LOG_PATTERN_DEV}</pattern>
            </encoder>
        </appender>
    </springProfile>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>
